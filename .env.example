# ─────────────────────────────────────────────────────────────────────────────
# Fahman Orders — environment variables (EXAMPLE). Copy to .env.local and fill.
# NEVER commit real secrets. `.env*` is git-ignored (see .gitignore). Set the real
# values in Vercel (Project → Settings → Environment Variables) and Supabase.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser; all others are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project → Settings → API). Region: Singapore (ap-southeast-1).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server-only; bypasses RLS for system automation
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# WhatsApp Business Cloud API (primary notification channel). Free tier; see D-21 §8.
WHATSAPP_TOKEN=YOUR-PERMANENT-OR-SYSTEM-USER-TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR-PHONE-NUMBER-ID
WHATSAPP_VERIFY_TOKEN=A-RANDOM-STRING-YOU-CHOOSE     # echoed during webhook verification
WHATSAPP_APP_SECRET=YOUR-META-APP-SECRET             # verifies X-Hub-Signature-256 on receipts

# Web Push (free fallback). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY
VAPID_SUBJECT=mailto:you@example.com

# App config
NEXT_PUBLIC_DEFAULT_LOCALE=en          # en | ar
NEXT_PUBLIC_APP_URL=http://localhost:3000
OTP_RATE_LIMIT_PER_HOUR=5              # OTP requests per phone per hour (FR-S-14)
BROADCAST_RATE_LIMIT_PER_DAY=10       # operator broadcasts per day (FR-O-12)
TZ=Asia/Kuala_Lumpur                   # MYT (UTC+8)

# Auto-close scheduled job (FR-S-04/05). The GitHub Actions cron posts to
# /api/admin/auto-close with this shared secret in the x-auto-close-secret header.
# Also set APP_URL + AUTO_CLOSE_SECRET as GitHub Actions repo secrets.
AUTO_CLOSE_SECRET=A-LONG-RANDOM-STRING-YOU-CHOOSE
